+// --- Drawing ---------------------------------------------------------------------
+
+void StremioController::drawLoading(const char* text) {
+  KDContext* ctx = screenContext();
+  ctx->fillRect(KDRect(0, 0, k_width, k_height), k_background);
+  drawCentered(ctx, "NumStremio", 18, k_accent, k_background, KDFont::Size::Large);
+  drawCentered(ctx, text, 100, k_text, k_background);
+  drawCentered(ctx, "Retour : annuler", 200, k_muted, k_background);
+}
+
+void StremioController::drawHeader(const char* title, const char* info) {
+  KDContext* ctx = screenContext();
+  ctx->fillRect(KDRect(0, 0, k_width, k_height), k_background);
+  ctx->fillRect(KDRect(0, 0, k_width, 24), k_panel);
+  drawText(ctx, 6, 5, title, k_text, k_panel, k_width - 12);
+  drawText(ctx, 6, 30, info, k_muted, k_background, k_width - 12);
+}
+
+void StremioController::drawBrowse() {
+  KDContext* ctx = screenContext();
+  const int gw = glyphWidth();
+  const int gh = glyphHeight();
+  ctx->fillRect(KDRect(0, 0, k_width, k_height), k_background);
+
+  // Search bar.
+  const bool searchFocus = m_focus == Focus::Search;
+  ctx->fillRect(KDRect(4, 3, k_width - 8, 22), searchFocus ? k_accent : k_panel);
+  ctx->fillRect(KDRect(6, 5, k_width - 12, 18), k_panel);
+  const Ion::Events::ShiftAlphaStatus mods = m_input.modifiers();
+  const char* mode = "123";
+  if (mods.alphaIsActive()) {
+    const bool upper = mods.shiftIsActive();
+    mode = mods.alphaIsLocked() ? (upper ? "ABC" : "abc") : (upper ? "A" : "a");
+  } else if (mods.shiftIsActive()) {
+    mode = "shift";
+  }
+  const int modeWidth = static_cast<int>(strlen(mode)) * gw;
+  const int fieldWidth = k_width - 12 - modeWidth - 16;
+  if (m_input.isEmpty()) {
+    drawText(ctx, 10, 8, "Rechercher un film, une serie...", k_muted, k_panel, fieldWidth);
+  } else {
+    const char* shown = tail(m_input.text(), fieldWidth / gw - 1);
+    ctx->drawString(shown, KDPoint(10, 8), KDGlyph::Style{k_text, k_panel, k_font});
+  }
+  if (searchFocus) {
+    ctx->drawString(mode, KDPoint(k_width - 10 - modeWidth, 8), KDGlyph::Style{k_accent, k_panel, k_font});
+  }
+
+  // Type column.
+  static const char* const k_types[3] = {"Tous", "Films", "Series"};
+  for (int i = 0; i < 3; i++) {
+    const bool selected = i == m_typeCursor.selection();
+    const KDColor bg = selected ? (m_focus == Focus::Type ? k_accent : k_selected) : k_panel;
+    ctx->fillRect(KDRect(4, k_listTop + i * k_rowHeight, 62, k_rowHeight - 2), bg);
+    drawText(ctx, 8, k_listTop + 3 + i * k_rowHeight, k_types[i], k_text, bg, 56);
+  }
+  drawText(ctx, 4, k_listTop + 3 * k_rowHeight + 4, "Type", k_muted, k_background, 62);
+
+  // Genre column.
+  for (int row = 0; row < m_genreCursor.visible(); row++) {
+    const int index = m_genreCursor.first() + row;
+    if (index >= m_genreCursor.count()) {
+      break;
+    }
+    const bool selected = index == m_genreCursor.selection();
+    const KDColor bg = selected ? (m_focus == Focus::Genre ? k_accent : k_selected) : k_panel;
+    ctx->fillRect(KDRect(70, k_listTop + row * k_rowHeight, 84, k_rowHeight - 2), bg);
+    drawText(ctx, 74, k_listTop + 3 + row * k_rowHeight, index == 0 ? "Tous genres" : m_genres[index - 1],
+             k_text, bg, 78);
+  }
+
+  // Titles column, with posters.
+  for (int row = 0; row < m_titleCursor.visible(); row++) {
+    const int index = m_titleCursor.first() + row;
+    const int y = k_listTop + row * k_titleRowHeight;
+    ctx->fillRect(KDRect(158, y, 158, k_titleRowHeight - 2), k_panel);
+    if (index >= m_itemCount) {
+      continue;
+    }
+    const bool selected = index == m_titleCursor.selection();
+    const KDColor bg = selected ? (m_focus == Focus::Titles ? k_accent : k_selected) : k_panel;
+    ctx->fillRect(KDRect(158, y, 158, k_titleRowHeight - 2), bg);
+    if (m_postersValid >> index & 1) {
+      Ion::Display::pushRect(KDRect(162, y + 2, Protocol::k_posterWidth, Protocol::k_posterHeight),
+                             m_posters[index]);
+    } else {
+      ctx->fillRect(KDRect(162, y + 2, Protocol::k_posterWidth, Protocol::k_posterHeight), k_background);
+    }
+    const Item& item = m_items[index];
+    const int textX = 162 + Protocol::k_posterWidth + 4;
+    const int textWidth = 316 - textX - 2;
+    drawText(ctx, textX, y + 4, item.title, k_text, bg, textWidth);
+    drawText(ctx, textX, y + 4 + gh + 2, item.info, k_muted, bg, textWidth);
+    drawText(ctx, textX, y + 4 + 2 * (gh + 2), item.kind == 2 ? "Serie" : "Film", k_warning, bg, textWidth);
+  }
+
+  // Footer.
+  const int footerY = k_height - gh - 3;
+  if (m_loading) {
+    drawText(ctx, 4, footerY, "Chargement...", k_warning, k_background, 150);
+  } else if (m_itemCount == 0) {
+    drawText(ctx, 4, footerY, "Aucun resultat", k_muted, k_background, 150);
+  } else {
+    char page[24] = "Page ";
+    number(page + 5, m_page + 1);
+    drawText(ctx, 4, footerY, page, k_muted, k_background, 80);
+  }
+  drawText(ctx, 100, footerY, "OK : ouvrir   retour : quitter", k_muted, k_background, 216);
+}
+
+void StremioController::drawEpisodes(const Cursor& seasons, const Cursor& episodes, bool inEpisodes) {
+  drawHeader(m_detailTitle, m_detailInfo);
+  KDContext* ctx = screenContext();
+  drawText(ctx, 4, 44, "Saisons", k_muted, k_background, 96);
+  drawText(ctx, 104, 44, "Episodes", k_muted, k_background, 100);
+  for (int row = 0; row < seasons.visible(); row++) {
+    const int index = seasons.first() + row;
+    if (index >= seasons.count()) break;
+    char label[16] = "Saison ";
+    number(label + 7, m_seasons[index]);
+    const bool selected = index == seasons.selection();
+    const KDColor bg = selected ? (inEpisodes ? k_selected : k_accent) : k_panel;
+    ctx->fillRect(KDRect(4, 50 + row * k_rowHeight, 96, k_rowHeight - 2), bg);
+    drawText(ctx, 8, 53 + row * k_rowHeight, m_seasons[index] == 0 ? "Hors saison" : label, k_text, bg, 90);
+  }
+  for (int row = 0; row < episodes.visible(); row++) {
+    const int index = episodes.first() + row;
+    if (index >= episodes.count()) break;
+    char label[48];
+    number(label, m_episodes[index].number);
+    size_t used = strlen(label);
+    label[used++] = '.';
+    label[used++] = ' ';
+    label[used] = '\0';
+    append(label, sizeof(label), m_episodes[index].title);
+    const bool selected = inEpisodes && index == episodes.selection();
+    const KDColor bg = selected ? k_accent : k_panel;
+    ctx->fillRect(KDRect(104, 50 + row * k_rowHeight, 212, k_rowHeight - 2), bg);
+    drawText(ctx, 108, 53 + row * k_rowHeight, label, k_text, bg, 204);
+  }
+  const int footerY = k_height - glyphHeight() - 3;
+  drawText(ctx, 4, footerY, "OK : choisir   retour : revenir", k_muted, k_background, 312);
+}
+
+void StremioController::drawSources() {
+  KDContext* ctx = screenContext();
+  const int gh = glyphHeight();
+  drawHeader(m_detailTitle, "Choisis une source");
+  drawText(ctx, 4, 44, "Fournisseur", k_muted, k_background, 80);
+  drawText(ctx, 100, 44, "Sources", k_muted, k_background, 100);
+
+  for (int row = 0; row < m_providerCursor.visible(); row++) {
+    const int index = m_providerCursor.first() + row;
+    if (index >= m_providerCursor.count()) {
+      break;
+    }
+    const bool selected = index == m_providerCursor.selection();
+    const KDColor bg = selected ? (m_sourceColumn == 0 ? k_accent : k_selected) : k_panel;
+    ctx->fillRect(KDRect(4, 58 + row * 22, 92, 20), bg);
+    drawText(ctx, 8, 62 + row * 22, index == 0 ? "Tous" : m_providers[index - 1], k_text, bg, 84);
+  }
+  for (int row = 0; row < m_streamCursor.visible(); row++) {
+    const int index = m_streamCursor.first() + row;
+    if (index >= m_filteredCount) {
+      break;
+    }
+    const bool selected = index == m_streamCursor.selection();
+    const KDColor bg = selected ? (m_sourceColumn == 1 ? k_accent : k_selected) : k_panel;
+    const Stream& stream = m_streams[m_filtered[index]];
+    ctx->fillRect(KDRect(100, 58 + row * 22, 216, 20), bg);
+    drawText(ctx, 104, 59 + row * 22, stream.line1, k_text, bg, 208);
+    drawText(ctx, 104, 59 + row * 22 + gh - 1, stream.line2, k_muted, bg, 208);
+  }
+
+  // Options: subtitles and connection speed, for the video that will play.
+  static const char* const k_speeds[4] = {"Auto", "Lente", "Moyenne", "Rapide"};
+  const int optionsY = 58 + 7 * 22 + 2;
+  for (int row = 0; row < 2; row++) {
+    const bool focus = m_sourceColumn == 2 && m_optionRow == row;
+    const KDColor bg = focus ? k_accent : k_panel;
+    ctx->fillRect(KDRect(4, optionsY + row * 11, 312, 11), bg);
+    char line[64];
+    line[0] = '\0';
+    if (row == 0) {
+      append(line, sizeof(line), "Sous-titres : ");
+      append(line, sizeof(line), m_subChoice == 0 ? "Aucun" : m_subLangs[m_subChoice - 1]);
+    } else {
+      append(line, sizeof(line), "Connexion : ");
+      append(line, sizeof(line), k_speeds[m_speedChoice]);
+    }
+    drawText(ctx, 8, optionsY + row * 11 - 1, line, k_text, bg, 304);
+  }
+}
