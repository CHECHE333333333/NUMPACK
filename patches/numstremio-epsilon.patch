diff --git a/epsilon/apps/numstremio/app.cpp b/epsilon/apps/numstremio/app.cpp
new file mode 100644
index 0000000000..79ece8a406
--- /dev/null
+++ b/epsilon/apps/numstremio/app.cpp
@@ -0,0 +1,35 @@
+#include "app.h"
+
+#include <escher/container.h>
+#include <ion/events.h>
+
+#include "numstremio_icon.h"
+
+namespace Numstremio {
+
+const Escher::Image* App::Descriptor::icon() const {
+  return ImageStore::NumstremioIcon;
+}
+
+App* App::Snapshot::unpack(Escher::Container* container) {
+  return new (container->currentAppBuffer()) App(this);
+}
+
+const App::Descriptor* App::Snapshot::descriptor() const {
+  constexpr static Descriptor s_descriptor;
+  return &s_descriptor;
+}
+
+App::App(Snapshot* snapshot)
+    : Escher::App(snapshot, &m_controller),
+      m_controller(&m_modalViewController),
+      m_usbTimer(&m_controller) {}
+
+void App::willBecomeInactive() {
+  // Give the USB port back, and leave the keyboard as we found it.
+  m_controller.disconnect();
+  Ion::Events::setShiftAlphaStatus(Ion::Events::ShiftAlphaStatus());
+  Escher::App::willBecomeInactive();
+}
+
+}  // namespace Numstremio
diff --git a/epsilon/apps/numstremio/app.h b/epsilon/apps/numstremio/app.h
new file mode 100644
index 0000000000..23853ab3e1
--- /dev/null
+++ b/epsilon/apps/numstremio/app.h
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <apps/i18n.h>
+#include <escher/app.h>
+
+#include "stremio_controller.h"
+
+namespace Numstremio {
+
+class App : public Escher::App {
+ public:
+  class Descriptor : public Escher::App::Descriptor {
+   public:
+    I18n::Message name() const override { return I18n::Message::NumstremioApp; }
+    I18n::Message upperName() const override {
+      return I18n::Message::NumstremioAppCapital;
+    }
+    const Escher::Image* icon() const override;
+  };
+
+  class Snapshot : public Escher::App::Snapshot {
+   public:
+    App* unpack(Escher::Container* container) override;
+    const Descriptor* descriptor() const override;
+  };
+
+  void willBecomeInactive() override;
+  int numberOfTimers() override { return 1; }
+  Escher::Timer* timerAtIndex(int i) override { return &m_usbTimer; }
+
+ private:
+  // Opens the session once the app is on screen.
+  class UsbTimer : public Escher::Timer {
+   public:
+    explicit UsbTimer(StremioController* controller)
+        : Escher::Timer(1), m_controller(controller) {}
+
+   private:
+    bool fire() override {
+      m_controller->tick();
+      return false;
+    }
+    StremioController* m_controller;
+  };
+
+  App(Snapshot* snapshot);
+  StremioController m_controller;
+  UsbTimer m_usbTimer;
+};
+
+}  // namespace Numstremio
diff --git a/epsilon/apps/numstremio/host_model_test.cpp b/epsilon/apps/numstremio/host_model_test.cpp
new file mode 100644
index 0000000000..e4b8783931
--- /dev/null
+++ b/epsilon/apps/numstremio/host_model_test.cpp
@@ -0,0 +1,70 @@
+// Host test of model.h:  g++ -std=c++17 -Wall -Wextra -o /tmp/m host_model_test.cpp && /tmp/m
+#include <assert.h>
+#include <stdio.h>
+
+#include "model.h"
+
+using namespace Numstremio;
+
+int main() {
+  {  // Reader: good frame
+    const uint8_t frame[] = {2, 1, 3, 'a', 'b', 'c', 4, 0xC3, 0xA9, 'x', 'y'};
+    Reader r(frame, sizeof(frame));
+    assert(r.u8() == 2);
+    assert(r.u8() == 1);
+    char s[8];
+    assert(r.str8(s, sizeof(s)) && !strcmp(s, "abc"));
+    assert(r.str8(s, sizeof(s)) && r.ok() && r.remaining() == 0);
+  }
+  {  // Reader: truncated string fails and stays failed
+    const uint8_t frame[] = {5, 'a', 'b'};
+    Reader r(frame, sizeof(frame));
+    char s[8];
+    assert(!r.str8(s, sizeof(s)));
+    assert(!r.ok());
+    assert(r.u8() == 0 && !r.ok());
+  }
+  {  // Reader: string longer than the buffer is cut on a character boundary
+    const uint8_t frame[] = {5, 'a', 0xC3, 0xA9, 'b', 'c'};
+    Reader r(frame, sizeof(frame));
+    char s[3];  // room for 2 bytes
+    assert(r.str8(s, sizeof(s)));
+    assert(!strcmp(s, "a"));  // the 2-byte "e acute" would be cut in half
+    assert(r.ok() && r.remaining() == 0);
+  }
+  {  // u16 little endian
+    const uint8_t frame[] = {0x34, 0x12};
+    Reader r(frame, 2);
+    assert(r.u16() == 0x1234);
+  }
+  {  // Cursor scrolling
+    Cursor c(4);
+    c.reset(6);
+    assert(!c.move(-1));
+    for (int i = 0; i < 5; i++) assert(c.move(1));
+    assert(c.selection() == 5 && c.first() == 2);
+    assert(!c.move(1));
+    for (int i = 0; i < 5; i++) assert(c.move(-1));
+    assert(c.selection() == 0 && c.first() == 0);
+    c.reset(0);
+    assert(!c.move(1) && !c.move(-1));
+    c.reset(6);
+    c.select(99);
+    assert(c.selection() == 5 && c.first() == 2);
+  }
+  assert(cycle(0, -1, 3) == 2 && cycle(2, 1, 3) == 0 && cycle(0, 1, 0) == 0);
+  {  // clip
+    char out[40];
+    clip(out, sizeof(out), "Short", 10);
+    assert(!strcmp(out, "Short"));
+    clip(out, sizeof(out), "The Lord of the Rings", 10);
+    assert(!strcmp(out, "The Lor..."));
+    clip(out, sizeof(out), "\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9\xC3\xA9", 4);
+    assert(!strcmp(out, "\xC3\xA9..."));
+    char tiny[6];
+    clip(tiny, sizeof(tiny), "abcdefghij", 20);
+    assert(strlen(tiny) <= 5);
+  }
+  puts("model: ok");
+  return 0;
+}
