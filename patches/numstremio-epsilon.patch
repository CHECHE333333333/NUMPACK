+namespace Numstremio {
+
+using Ion::Keyboard::Key;
+
+namespace {
+
+constexpr KDColor k_background = KDColor::RGB24(0x12101F);
+constexpr KDColor k_panel = KDColor::RGB24(0x221F3A);
+constexpr KDColor k_selected = KDColor::RGB24(0x3A3566);
+constexpr KDColor k_text = KDColorWhite;
+constexpr KDColor k_muted = KDColor::RGB24(0xA29FC0);
+constexpr KDColor k_accent = KDColor::RGB24(0x8B6CF7);
+constexpr KDColor k_warning = KDColor::RGB24(0xFFB734);
+
+constexpr KDFont::Size k_font = KDFont::Size::Small;
+constexpr int k_width = 320;
+constexpr int k_height = 240;
+constexpr int k_rowHeight = 20;
+constexpr int k_titleRowHeight = 48;
+constexpr int k_listTop = 28;
+constexpr uint32_t k_detailTimeoutMs = 45000;
+constexpr uint32_t k_streamsTimeoutMs = 70000;
+constexpr uint32_t k_listTimeoutMs = 30000;
+
+bool isExitKey(Key key) { return key == Key::Home || key == Key::OnOff; }
+
+uint32_t bit(uint8_t type) { return type >= 0xB0 && type < 0xD0 ? 1u << (type - 0xB0) : 0; }
+
+KDContext* screenContext() {
+  KDContext* context = Ion::Display::Context::SharedContext;
+  context->setOrigin(KDPointZero);
+  context->setClippingRect(KDRect(0, 0, Ion::Display::Width, Ion::Display::Height));
+  return context;
+}
+
+int glyphWidth() { return KDFont::GlyphMaxWidth(k_font); }
+int glyphHeight() { return KDFont::GlyphHeight(k_font); }
+
+// Draws `text` cut to `widthPx`, ending with "..." when too long.
+void drawText(KDContext* ctx, int x, int y, const char* text, KDColor color,
+              KDColor background, int widthPx) {
+  char buffer[80];
+  int glyphs = widthPx / glyphWidth();
+  if (glyphs < 1) {
+    return;
+  }
+  clip(buffer, sizeof(buffer), text, glyphs);
+  ctx->drawString(buffer, KDPoint(x, y), KDGlyph::Style{color, background, k_font});
+}
+
+void drawCentered(KDContext* ctx, const char* text, int y, KDColor color,
+                  KDColor background, KDFont::Size font = k_font) {
+  const int width = KDFont::GlyphMaxWidth(font);
+  const int height = KDFont::GlyphHeight(font);
+  const KDGlyph::Style style{color, background, font};
+  while (*text != '\0') {
+    const char* end = strchr(text, '\n');
+    const size_t bytes = end ? static_cast<size_t>(end - text) : strlen(text);
+    int glyphs = 0;
+    for (size_t i = 0; i < bytes; i++) {
+      const uint8_t byte = static_cast<uint8_t>(text[i]);
+      if ((byte & 0xC0) != 0x80 && byte != 0xCC && byte != 0xCD) {
+        glyphs++;
+      }
+    }
+    const int x = (k_width - glyphs * width) / 2;
+    ctx->drawString(text, KDPoint(x < 0 ? 0 : x, y), style, static_cast<int>(bytes));
+    y += height + 2;
+    text += bytes;
+    if (*text == '\n') {
+      text++;
+    }
+  }
+}
+
+// Last `glyphs` characters of the text (typing is easier to follow that way).
+const char* tail(const char* text, int glyphs) {
+  int count = 0;
+  for (const char* c = text; *c != '\0'; c++) {
+    const uint8_t byte = static_cast<uint8_t>(*c);
+    if ((byte & 0xC0) != 0x80 && byte != 0xCC && byte != 0xCD) {
+      count++;
+    }
+  }
+  const char* start = text;
+  while (count > glyphs && *start != '\0') {
+    start++;
+    while (*start != '\0' &&
+           (((static_cast<uint8_t>(*start) & 0xC0) == 0x80) ||
+            static_cast<uint8_t>(*start) == 0xCC || static_cast<uint8_t>(*start) == 0xCD)) {
+      start++;
+    }
+    count--;
+  }
+  return start;
+}
+
+// Appends `text` to `destination` (capacity bytes in all), never overflowing.
+void append(char* destination, size_t capacity, const char* text) {
+  const size_t used = strlen(destination);
+  if (used + 1 >= capacity) {
+    return;
+  }
+  size_t count = strlen(text);
+  if (count > capacity - used - 1) {
+    count = capacity - used - 1;
+  }
+  memcpy(destination + used, text, count);
+  destination[used + count] = '\0';
+}
+
+void number(char* out, int value) {  // small non-negative integers
+  char digits[6];
+  int n = 0;
+  do {
+    digits[n++] = static_cast<char>('0' + value % 10);
+    value /= 10;
+  } while (value > 0 && n < 5);
+  while (n > 0) {
+    *out++ = digits[--n];
+  }
+  *out = '\0';
+}
+
+}  // namespace
+
+// --- Start view -------------------------------------------------------------
+
+void StartView::drawRect(KDContext* ctx, KDRect rect) const {
+  ctx->fillRect(bounds(), k_background);
+  drawCentered(ctx, "NumStremio", 18, k_accent, k_background, KDFont::Size::Large);
+  const char* message = m_controller->message();
+  if (message[0] != '\0') {
+    drawCentered(ctx, message, 70, k_text, k_background);
+    drawCentered(ctx, "OK : relancer", 190, k_accent, k_background);
+    return;
+  }
+  drawCentered(ctx,
+               "Des films et des series sur la calculatrice.\n"
+               "Laisse l'appli NumSocial ouverte sur le PC.",
+               52, k_text, k_background);
+  drawCentered(ctx,
+               "Recherche : tape le titre, EXE\n"
+               "Sinon : type, genre, puis le titre\n"
+               "fleches : naviguer   OK : choisir\n"
+               "retour : revenir   maison : quitter",
+               100, k_muted, k_background);
+  drawCentered(ctx, "OK : ouvrir NumStremio", 192, k_accent, k_background);
+}
+
+// --- Controller -------------------------------------------------------------
+
+StremioController::StremioController(Escher::Responder* parentResponder)
+    : Escher::ViewController(parentResponder),
+      m_view(this),
+      m_player(&m_link),
+      m_autoStart(true),
+      m_quit(false),
+      m_lost(false),
+      m_errorSeen(false),
+      m_seen(0),
+      m_lastFrame(0),
+      m_focus(Focus::Search),
+      m_kind(0),
+      m_genre(0),
+      m_page(0),
+      m_more(false),
+      m_loading(false),
+      m_genreCount(0),
+      m_typeCursor(3),
+      m_genreCursor(9),
+      m_titleCursor(4),
+      m_itemCount(0),
+      m_postersValid(0),
+      m_detailKind(0),
+      m_seasonCount(0),
+      m_episodeCount(0),
+      m_providerCount(0),
+      m_streamCount(0),
+      m_subCount(0),
+      m_filteredCount(0),
+      m_subChoice(0),
+      m_speedChoice(0),
+      m_providerCursor(7),
+      m_streamCursor(7),
+      m_optionRow(0),
+      m_sourceColumn(1) {
+  m_message[0] = '\0';
+  m_query[0] = '\0';
+  m_detailTitle[0] = m_detailInfo[0] = '\0';
+}
+
+void StremioController::viewWillAppear() { m_view.redrawAll(); }
+
+void StremioController::showMessage(const char* message) {
+  const size_t length = strlen(message);
+  const size_t count = length < sizeof(m_message) - 1 ? length : sizeof(m_message) - 1;
+  memcpy(m_message, message, count);
+  m_message[count] = '\0';
+  m_view.redrawAll();
+  AppsContainer::sharedAppsContainer()->redrawWindow();
+}
+
+void StremioController::tick() {
+  if (m_autoStart) {
+    m_autoStart = false;
+    runSession();
+  }
+}
+
+bool StremioController::handleEvent(Ion::Events::Event event) {
+  // Plugging the cable would open the DFU screen: we own the USB port instead.
+  if (event == Ion::Events::USBEnumeration) {
+    Ion::USB::clearEnumerationInterrupt();
+    return true;
+  }
+  if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+    runSession();
+    return true;
+  }
+  return false;
+}
+
+void StremioController::drain(uint32_t ms) {
+  const uint64_t end = Ion::Timing::millis() + ms;
+  uint8_t type;
+  const uint8_t* payload;
+  uint16_t length;
+  while (Ion::Timing::millis() < end) {
+    m_link.poll(&type, &payload, &length);
+  }
+}
+
+void StremioController::closeSession() {
+  drain(150);
+  m_link.disconnect();
+  AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+  m_view.redrawAll();
+  AppsContainer::sharedAppsContainer()->redrawWindow();
+}
+
+/* While connected, the calculator never hands control back to Epsilon's event
+ * loop (the USB port would stop answering): the whole session runs here. */
+void StremioController::runSession() {
+  m_message[0] = '\0';
+  m_quit = m_lost = false;
+  if (!m_link.isConnected()) {
+    showMessage("Connexion a l'ordinateur...\nOuvre l'appli NumSocial sur le PC.\n\nRetour : annuler");
+    m_message[0] = '\0';
+    switch (m_link.connect()) {
+      case Numtube::Link::ConnectResult::Connected:
+        break;
+      case Numtube::Link::ConnectResult::Cancelled:
+        m_view.redrawAll();
+        AppsContainer::sharedAppsContainer()->redrawWindow();
+        return;
+      case Numtube::Link::ConnectResult::NoCable:
+        showMessage("Branche la calculatrice a l'ordinateur avec le cable USB.");
+        return;
+    }
+  }
+  m_link.log("numstremio: session");
+  m_genreCount = 0;
+  m_genreCursor.reset(1);
+  m_typeCursor.reset(3);
+  m_kind = m_genre = m_page = 0;
+  m_query[0] = '\0';
+  m_input.clear();
+  m_focus = Focus::Search;
+  clearItems();
+  m_seen = 0;
+  m_link.send(Protocol::Start, nullptr, 0);
+  browse();
+  closeSession();
+  if (m_lost) {
+    showMessage("Le PC ne repond plus.\nL'appli NumSocial est-elle ouverte ?");
+  }
+}
+
+// --- Frames -------------------------------------------------------------------
+
+void StremioController::clearItems() {
+  m_itemCount = 0;
+  m_postersValid = 0;
+  m_more = false;
+  m_titleCursor.reset(0);
+}
+
+bool StremioController::sendBrowse() {
+  clearItems();
+  m_loading = true;
+  uint8_t buffer[4 + k_maxQuery];
+  buffer[0] = static_cast<uint8_t>(m_kind);
+  buffer[1] = static_cast<uint8_t>(m_genre);
+  buffer[2] = static_cast<uint8_t>(m_page & 0xFF);
+  buffer[3] = static_cast<uint8_t>(m_page >> 8);
+  const size_t length = strlen(m_query);
+  memcpy(buffer + 4, m_query, length);
+  return m_link.send(Protocol::Browse, buffer, static_cast<uint16_t>(4 + length));
+}
+
+bool StremioController::pump(int budget) {
+  bool any = false;
+  uint8_t type;
+  const uint8_t* payload;
+  uint16_t length;
+  for (int i = 0; i < budget && m_link.poll(&type, &payload, &length); i++) {
+    any = true;
+    m_lastFrame = Ion::Timing::millis();
+    handleFrame(type, payload, length);
+  }
+  return any;
+}
+
+void StremioController::handleFrame(uint8_t type, const uint8_t* payload, uint16_t length) {
+  Reader r(payload, length);
+  switch (type) {
+    case Protocol::Error: {
+      m_errorSeen = true;
+      m_loading = false;
+      const size_t count = length < sizeof(m_message) - 1 ? length : sizeof(m_message) - 1;
+      memcpy(m_message, payload, count);
+      m_message[count] = '\0';
+      return;
+    }
+    case Protocol::Config: {
+      const int n = r.u8();
+      m_genreCount = 0;
+      for (int i = 0; i < n && i < k_maxGenres; i++) {
+        if (!r.str8(m_genres[i], sizeof(m_genres[i]))) {
+          break;
+        }
+        m_genreCount++;
+      }
+      m_genreCursor.reset(m_genreCount + 1);
+      break;
+    }
+    case Protocol::Item: {
+      const int slot = r.u8();
+      Item item;
+      item.kind = r.u8();
+      r.str8(item.id, sizeof(item.id));
+      r.str8(item.title, sizeof(item.title));
+      r.str8(item.info, sizeof(item.info));
+      if (r.ok() && slot < Protocol::k_pageSize) {
+        m_items[slot] = item;
+        if (slot >= m_itemCount) {
+          m_itemCount = slot + 1;
+        }
+        m_titleCursor.reset(m_itemCount);
+      }
+      break;
+    }
+    case Protocol::ListDone: {
+      const int count = r.u8();
+      m_more = r.u8() != 0;
+      r.u16();
+      if (r.ok()) {
+        m_itemCount = count < Protocol::k_pageSize ? count : Protocol::k_pageSize;
+        m_titleCursor.reset(m_itemCount);
+        m_loading = false;
+      }
+      break;
+    }
+    case Protocol::Poster: {
+      const int slot = r.u8();
+      const int w = r.u8();
+      const int h = r.u8();
+      if (r.ok() && slot < Protocol::k_pageSize && w == Protocol::k_posterWidth &&
+          h == Protocol::k_posterHeight &&
+          r.remaining() >= static_cast<size_t>(w * h * 2)) {
+        const uint8_t* pixels = r.position();
+        for (int i = 0; i < w * h; i++) {
+          m_posters[slot][i] =
+              KDColor::RGB16(static_cast<uint16_t>(pixels[2 * i] | (pixels[2 * i + 1] << 8)));
+        }
+        m_postersValid |= static_cast<uint8_t>(1 << slot);
+      }
+      break;
+    }
+    case Protocol::Detail: {
+      m_detailKind = r.u8();
+      r.str8(m_detailTitle, sizeof(m_detailTitle));
+      r.str8(m_detailInfo, sizeof(m_detailInfo));
+      const int n = r.u8();
+      m_seasonCount = 0;
+      for (int i = 0; i < n && i < k_maxSeasons; i++) {
+        m_seasons[m_seasonCount++] = r.u8();
+      }
+      break;
+    }
+    case Protocol::Episode: {
+      Episode episode;
+      episode.number = r.u16();
+      r.str8(episode.title, sizeof(episode.title));
+      if (r.ok() && m_episodeCount < k_maxEpisodes) {
+        m_episodes[m_episodeCount++] = episode;
+      }
+      break;
+    }
+    case Protocol::Providers: {
+      const int n = r.u8();
+      m_providerCount = 0;
+      for (int i = 0; i < n && i < k_maxProviders; i++) {
+        if (!r.str8(m_providers[i], sizeof(m_providers[i]))) {
+          break;
+        }
+        m_providerCount++;
+      }
+      break;
+    }
+    case Protocol::Stream: {
+      const int index = r.u8();
+      Stream stream;
+      stream.provider = r.u8();
+      r.str8(stream.line1, sizeof(stream.line1));
+      r.str8(stream.line2, sizeof(stream.line2));
+      if (r.ok() && index < k_maxStreams) {
+        m_streams[index] = stream;
+        if (index >= m_streamCount) {
+          m_streamCount = static_cast<uint8_t>(index + 1);
+        }
+      }
+      break;
+    }
+    case Protocol::StreamsDone: {
+      const int count = r.u8();
+      if (r.ok() && count < m_streamCount) {
+        m_streamCount = static_cast<uint8_t>(count);
+      }
+      break;
+    }
+    case Protocol::SubLangs: {
+      const int n = r.u8();
+      m_subCount = 0;
+      for (int i = 0; i < n && i < k_maxSubLangs; i++) {
+        if (!r.str8(m_subLangs[i], sizeof(m_subLangs[i]))) {
+          break;
+        }
+        m_subCount++;
+      }
+      break;
+    }
+    default:
+      return;
+  }
+  if (r.ok()) {
+    m_seen |= bit(type);
+  }
+}
+
+StremioController::Wait StremioController::request(uint8_t type, const uint8_t* payload,
+                                                  uint16_t length, uint8_t doneType,
+                                                  uint32_t timeoutMs, const char* text) {
+  m_seen &= ~bit(doneType);
+  m_errorSeen = false;
+  m_message[0] = '\0';
+  m_link.send(type, payload, length);
+  drawLoading(text);
+  Numtube::KeyWatcher keys;
+  const uint64_t start = Ion::Timing::millis();
+  while (true) {
+    const Key key = keys.next();
+    if (isExitKey(key)) {
+      m_quit = true;
+      return Wait::Quit;
+    }
+    if (key == Key::Back) {
+      return Wait::Back;
+    }
+    if (!Numtube::cablePlugged()) {
+      m_lost = true;
+      return Wait::Lost;
+    }
+    pump(16);
+    if (m_seen & bit(doneType)) {
+      return Wait::Done;
+    }
+    if (m_errorSeen) {
+      return Wait::Error;
+    }
+    if (Ion::Timing::millis() - start > timeoutMs) {
+      return Wait::Timeout;
+    }
+  }
+}
+
+// A message the user acknowledges with any key (or after a few seconds).
+void StremioController::notify(const char* text) {
+  KDContext* ctx = screenContext();
+  ctx->fillRect(KDRect(10, 70, 300, 100), k_panel);
+  ctx->fillRect(KDRect(10, 70, 300, 2), k_warning);
+  drawCentered(ctx, text, 84, k_text, k_panel);
+  drawCentered(ctx, "OK : continuer", 150, k_accent, k_panel);
+  Numtube::KeyWatcher keys;
+  const uint64_t start = Ion::Timing::millis();
+  while (Ion::Timing::millis() - start < 8000) {
+    const Key key = keys.next();
+    if (isExitKey(key)) {
+      m_quit = true;
+      return;
+    }
+    if (key != Key::None) {
+      return;
+    }
+    if (!Numtube::cablePlugged()) {
+      m_lost = true;
+      return;
+    }
+    pump(8);
+  }
+}
+
+// --- Browse -------------------------------------------------------------------
+
+void StremioController::browse() {
+  Numtube::KeyWatcher keys;
+  bool leave = false;
+  bool dirty = true;
+  sendBrowse();
+  while (!leave && keepGoing()) {
+    const Key key = keys.next();
+    if (key != Key::None) {
+      browseKey(key, &leave);
+      keys = Numtube::KeyWatcher();  // nothing typed meanwhile counts twice
+      dirty = true;
+      if (m_errorSeen) {
+        m_errorSeen = false;
+        if (m_message[0] != '\0') {
+          notify(m_message);
+          m_message[0] = '\0';
+        }
+      }
+    }
+    if (pump(32)) {
+      dirty = true;
+      if (m_errorSeen) {
+        m_errorSeen = false;
+        m_loading = false;
+        notify(m_message);
+        m_message[0] = '\0';
+        keys = Numtube::KeyWatcher();
+      }
+    }
+    if (!Numtube::cablePlugged()) {
+      m_lost = true;
+    }
+    if (dirty && keepGoing() && !leave) {
+      drawBrowse();
+      dirty = false;
+    }
+  }
+}
+
+void StremioController::browseKey(Key key, bool* leave) {
+  if (isExitKey(key)) {
+    m_quit = true;
+    *leave = true;
+    return;
+  }
+  if (m_focus == Focus::Search) {
+    if (m_input.handleKey(key) != Numchat::TextInput::Result::Ignored) {
+      return;
+    }
+    switch (key) {
+      case Key::Down:
+        m_focus = m_itemCount > 0 ? Focus::Titles : Focus::Type;
+        break;
+      case Key::OK:
+      case Key::EXE: {
+        const size_t length = m_input.length() < k_maxQuery ? m_input.length() : k_maxQuery;
+        memcpy(m_query, m_input.text(), length);
+        m_query[length] = '\0';
+        m_page = 0;
+        sendBrowse();
+        m_focus = Focus::Titles;
+        break;
+      }
+      case Key::Back:
+        *leave = true;
+        break;
+      default:
+        break;
+    }
+    return;
+  }
+  Cursor& column = m_focus == Focus::Type ? m_typeCursor
+                   : m_focus == Focus::Genre ? m_genreCursor
+                                             : m_titleCursor;
+  switch (key) {
+    case Key::Back:
+      *leave = true;
+      break;
+    case Key::Left:
+      if (m_focus != Focus::Type) {
+        m_focus = m_focus == Focus::Titles ? Focus::Genre : Focus::Type;
+      }
+      break;
+    case Key::Right:
+      if (m_focus == Focus::Titles) {
+        if (m_itemCount > 0) {
+          openItem(m_titleCursor.selection());
+        }
+      } else {
+        m_focus = m_focus == Focus::Type ? Focus::Genre : Focus::Titles;
+      }
+      break;
+    case Key::OK:
+    case Key::EXE:
+      if (m_focus == Focus::Titles) {
+        if (m_itemCount > 0) {
+          openItem(m_titleCursor.selection());
+        }
+      } else {
+        m_focus = m_focus == Focus::Type ? Focus::Genre : Focus::Titles;
+      }
+      break;
+    case Key::Up:
+      if (column.move(-1)) {
+        if (m_focus != Focus::Titles) {
+          m_kind = m_typeCursor.selection();
+          m_genre = m_genreCursor.selection();
+          m_page = 0;
+          sendBrowse();
+        }
+      } else if (m_focus == Focus::Titles && m_page > 0) {
+        m_page--;
+        sendBrowse();
+      } else {
+        m_focus = Focus::Search;
+      }
+      break;
+    case Key::Down:
+      if (column.move(1)) {
+        if (m_focus != Focus::Titles) {
+          m_kind = m_typeCursor.selection();
+          m_genre = m_genreCursor.selection();
+          m_page = 0;
+          sendBrowse();
+        }
+      } else if (m_focus == Focus::Titles && m_more && !m_loading) {
+        m_page++;
+        sendBrowse();
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+// --- Details, episodes, sources ----------------------------------------------
+
+void StremioController::openItem(int slot) {
+  const Item& item = m_items[slot];
+  uint8_t buffer[2 + sizeof(item.id)];
+  const size_t idLength = strlen(item.id);
+  buffer[0] = item.kind;
+  buffer[1] = static_cast<uint8_t>(idLength);
+  memcpy(buffer + 2, item.id, idLength);
+  m_seasonCount = 0;
+  const Wait result = request(Protocol::Open, buffer, static_cast<uint16_t>(2 + idLength),
+                              Protocol::Detail, k_detailTimeoutMs, "Chargement...");
+  if (result == Wait::Error) {
+    notify(m_message);
+    return;
+  }
+  if (result == Wait::Timeout) {
+    notify("Le PC ne repond pas.");
+    return;
+  }
+  if (result != Wait::Done) {
+    return;
+  }
+  if (m_detailKind == 1 || m_seasonCount == 0) {
+    if (m_detailKind == 2) {
+      notify("Aucun episode trouve.");
+      return;
+    }
+    sources(Protocol::k_noSeason, 0);
+  } else {
+    episodes();
+  }
+}
+
+void StremioController::episodes() {
+  Cursor seasons(8);
+  Cursor episodes(8);
+  seasons.reset(m_seasonCount);
+  bool inEpisodes = false;
+  bool loaded = false;
+  Numtube::KeyWatcher keys;
+  bool dirty = true;
+  while (keepGoing()) {
+    if (!loaded) {
+      loaded = true;
+      const uint8_t season = m_seasons[seasons.selection()];
+      m_episodeCount = 0;
+      const Wait result = request(Protocol::Season, &season, 1, Protocol::EpisodesDone,
+                                  k_listTimeoutMs, "Chargement...");
+      if (result == Wait::Error) {
+        notify(m_message);
+      } else if (result != Wait::Done) {
+        if (result == Wait::Timeout) {
+          notify("Le PC ne repond pas.");
+        }
+        return;
+      }
+      episodes.reset(m_episodeCount);
+      keys = Numtube::KeyWatcher();
+      dirty = true;
+    }
+    const Key key = keys.next();
+    if (isExitKey(key)) {
+      m_quit = true;
+      return;
+    }
+    if (key != Key::None) {
+      dirty = true;
+      switch (key) {
+        case Key::Back:
+          if (inEpisodes) {
+            inEpisodes = false;
+          } else {
+            return;
+          }
+          break;
+        case Key::Left:
+          inEpisodes = false;
+          break;
+        case Key::Right:
+          inEpisodes = m_episodeCount > 0;
+          break;
+        case Key::Up:
+        case Key::Down: {
+          const int delta = key == Key::Up ? -1 : 1;
+          if (inEpisodes) {
+            episodes.move(delta);
+          } else if (seasons.move(delta)) {
+            loaded = false;
+          }
+          break;
+        }
+        case Key::OK:
+        case Key::EXE:
+          if (!inEpisodes) {
+            inEpisodes = m_episodeCount > 0;
+          } else {
+            sources(m_seasons[seasons.selection()], m_episodes[episodes.selection()].number);
+            keys = Numtube::KeyWatcher();
+          }
+          break;
+        default:
+          break;
+      }
+    }
+    pump(16);
+    if (!Numtube::cablePlugged()) {
+      m_lost = true;
+    }
+    if (dirty && loaded && keepGoing()) {
+      dirty = false;
+      drawEpisodes(seasons, episodes, inEpisodes);
+    }
+  }
+}
+
+void StremioController::rebuildFilter(int provider) {
+  m_filteredCount = 0;
+  for (int i = 0; i < m_streamCount; i++) {
+    if (provider == 0 || m_streams[i].provider == provider) {
+      m_filtered[m_filteredCount++] = static_cast<uint8_t>(i);
+    }
+  }
+  m_streamCursor.reset(m_filteredCount);
+}
+
+void StremioController::sources(uint8_t season, uint16_t episode) {
+  uint8_t buffer[3] = {season, static_cast<uint8_t>(episode & 0xFF),
+                       static_cast<uint8_t>(episode >> 8)};
+  m_providerCount = m_streamCount = m_subCount = 0;
+  const Wait result = request(Protocol::Streams, buffer, 3, Protocol::SubLangs,
+                              k_streamsTimeoutMs, "Recherche des sources...");
+  if (result == Wait::Error) {
+    notify(m_message);
+    return;
+  }
+  if (result == Wait::Timeout) {
+    notify("Les sources mettent trop de temps.");
+    return;
+  }
+  if (result != Wait::Done) {
+    return;
+  }
+  if (m_streamCount == 0) {
+    notify("Aucune source trouvee.\nAjoute un addon de sources\ndans l'appli NumSocial.");
+    return;
+  }
+  m_providerCursor.reset(m_providerCount + 1);
+  rebuildFilter(0);
+  m_sourceColumn = 1;
+  m_optionRow = 0;
+  if (m_subChoice > m_subCount) {
+    m_subChoice = 0;
+  }
+  Numtube::KeyWatcher keys;
+  bool dirty = true;
+  while (keepGoing()) {
+    const Key key = keys.next();
+    if (isExitKey(key)) {
+      m_quit = true;
+      return;
+    }
+    if (key != Key::None) {
+      dirty = true;
+      switch (key) {
+        case Key::Back:
+          return;
+        case Key::Left:
+          if (m_sourceColumn == 2) {
+            if (m_optionRow == 0) {
+              m_subChoice = cycle(m_subChoice, -1, m_subCount + 1);
+            } else {
+              m_speedChoice = cycle(m_speedChoice, -1, 4);
+            }
+          } else if (m_sourceColumn == 1) {
+            m_sourceColumn = 0;
+          }
+          break;
+        case Key::Right:
+          if (m_sourceColumn == 2) {
+            if (m_optionRow == 0) {
+              m_subChoice = cycle(m_subChoice, 1, m_subCount + 1);
+            } else {
+              m_speedChoice = cycle(m_speedChoice, 1, 4);
+            }
+          } else if (m_sourceColumn == 0) {
+            m_sourceColumn = 1;
+          }
+          break;
+        case Key::Up:
+          if (m_sourceColumn == 2) {
+            if (m_optionRow == 0) {
+              m_sourceColumn = 1;
+            } else {
+              m_optionRow = 0;
+            }
+          } else if (m_sourceColumn == 0) {
+            if (m_providerCursor.move(-1)) {
+              rebuildFilter(m_providerCursor.selection());
+            }
+          } else {
+            m_streamCursor.move(-1);
+          }
+          break;
+        case Key::Down:
+          if (m_sourceColumn == 2) {
+            m_optionRow = 1;
+          } else if (m_sourceColumn == 0) {
+            if (m_providerCursor.move(1)) {
+              rebuildFilter(m_providerCursor.selection());
+            } else {
+              m_sourceColumn = 2;
+            }
+          } else if (!m_streamCursor.move(1)) {
+            m_sourceColumn = 2;
+          }
+          break;
+        case Key::OK:
+        case Key::EXE:
+          if (m_sourceColumn == 0) {
+            m_sourceColumn = 1;
+          } else if (m_sourceColumn == 2) {
+            if (m_optionRow == 0) {
+              m_subChoice = cycle(m_subChoice, 1, m_subCount + 1);
+            } else {
+              m_speedChoice = cycle(m_speedChoice, 1, 4);
+            }
+          } else if (m_filteredCount > 0) {
+            play(m_filtered[m_streamCursor.selection()]);
+            keys = Numtube::KeyWatcher();
+          }
+          break;
+        default:
+          break;
+      }
+    }
+    pump(16);
+    if (!Numtube::cablePlugged()) {
+      m_lost = true;
+    }
+    if (dirty && keepGoing()) {
+      dirty = false;
+      drawSources();
+    }
+  }
+}
+
+void StremioController::play(int streamIndex) {
+  char id[24];
+  char* out = id;
+  *out++ = '@';
+  number(out, streamIndex);
+  out += strlen(out);
+  *out++ = '.';
+  number(out, m_subChoice);
+  out += strlen(out);
+  *out++ = '.';
+  number(out, m_speedChoice);
+  const Numtube::Player::Exit exit = m_player.play(id);
+  drain(300);  // late video frames
+  AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+  switch (exit) {
+    case Numtube::Player::Exit::Error:
+      notify(m_player.errorMessage()[0] != '\0' ? m_player.errorMessage() : "Lecture impossible.");
+      break;
+    case Numtube::Player::Exit::Disconnected:
+      m_lost = true;
+      break;
+    default:
+      break;
+  }
+}
