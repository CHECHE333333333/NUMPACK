+class StremioController;
+
+// Start and error screen. Everything else is drawn straight to the display by
+// the session loop (the calculator never returns to Escher while connected).
+class StartView : public Escher::View {
+ public:
+  explicit StartView(const StremioController* controller) : m_controller(controller) {}
+  void drawRect(KDContext* ctx, KDRect rect) const override;
+  void redrawAll() { markRectAsDirty(bounds()); }
+
+ private:
+  const StremioController* m_controller;
+};
+
+class StremioController : public Escher::ViewController {
+ public:
+  explicit StremioController(Escher::Responder* parentResponder);
+
+  Escher::View* view() override { return &m_view; }
+  bool handleEvent(Ion::Events::Event event) override;
+  void viewWillAppear() override;
+  void disconnect() { m_link.disconnect(); }
+  // Called by the app's timer while Escher runs: opens the session once.
+  void tick();
+  const char* message() const { return m_message; }
+
+  static constexpr int k_maxGenres = 24;
+  static constexpr int k_maxSeasons = 40;
+  static constexpr int k_maxEpisodes = 60;
+  static constexpr int k_maxProviders = 12;
+  static constexpr int k_maxStreams = 30;
+  static constexpr int k_maxSubLangs = 12;
+  static constexpr int k_maxQuery = 60;
+
+ private:
+  enum class Wait { Done, Back, Quit, Lost, Error, Timeout };
+  enum class Focus { Search, Type, Genre, Titles };
+
+  struct Item {
+    uint8_t kind;
+    char id[40];
+    char title[44];
+    char info[28];
+  };
+  struct Episode {
+    uint16_t number;
+    char title[32];
+  };
+  struct Stream {
+    uint8_t provider;
+    char line1[48];
+    char line2[48];
+  };
+
+  // Session
+  void showMessage(const char* message);
+  void runSession();
+  void closeSession();
+  bool keepGoing() const { return !m_quit && !m_lost; }
+
+  // Frames
+  bool pump(int budget);
+  void handleFrame(uint8_t type, const uint8_t* payload, uint16_t length);
+  Wait request(uint8_t type, const uint8_t* payload, uint16_t length, uint8_t doneType,
+               uint32_t timeoutMs, const char* text);
+  void notify(const char* text);
+  void drain(uint32_t ms);
+  bool sendBrowse();
+  void clearItems();
+
+  // Screens
+  void browse();
+  void browseKey(Ion::Keyboard::Key key, bool* leave);
+  void openItem(int slot);
+  void episodes();
+  void sources(uint8_t season, uint16_t episode);
+  void play(int streamIndex);
+  void rebuildFilter(int provider);
+
+  // Drawing
+  void drawBrowse();
+  void drawEpisodes(const Cursor& seasons, const Cursor& episodes, bool inEpisodes);
+  void drawSources();
+  void drawLoading(const char* text);
+  void drawHeader(const char* title, const char* info);
+
+  StartView m_view;
+  Numtube::Link m_link;
+  Numtube::Player m_player;
+  Numchat::TextInput m_input;
+  bool m_autoStart;
+  bool m_quit;
+  bool m_lost;
+  bool m_errorSeen;
+  uint32_t m_seen;  // bit (type - 0xB0): frame received since the request
+  uint64_t m_lastFrame;
+  char m_message[120];
+
+  // Browse state
+  Focus m_focus;
+  int m_kind;   // 0 all, 1 movies, 2 series
+  int m_genre;  // 0 all, else 1-based
+  int m_page;
+  bool m_more;
+  bool m_loading;
+  char m_query[k_maxQuery + 1];
+  uint8_t m_genreCount;
+  char m_genres[k_maxGenres][16];
+  Cursor m_typeCursor;
+  Cursor m_genreCursor;
+  Cursor m_titleCursor;
+  Item m_items[Protocol::k_pageSize];
+  int m_itemCount;
+  uint8_t m_postersValid;
+  KDColor m_posters[Protocol::k_pageSize][Protocol::k_posterWidth * Protocol::k_posterHeight];
+
+  // Detail
+  uint8_t m_detailKind;
+  char m_detailTitle[64];
+  char m_detailInfo[44];
+  uint8_t m_seasonCount;
+  uint8_t m_seasons[k_maxSeasons];
+  Episode m_episodes[k_maxEpisodes];
+  int m_episodeCount;
+
+  // Sources
+  uint8_t m_providerCount;
+  char m_providers[k_maxProviders][16];
+  uint8_t m_streamCount;
+  Stream m_streams[k_maxStreams];
+  uint8_t m_subCount;
+  char m_subLangs[k_maxSubLangs][16];
+  uint8_t m_filtered[k_maxStreams];
+  int m_filteredCount;
+  int m_subChoice;    // 0 none, else 1-based
+  int m_speedChoice;  // 0 auto, 1 low, 2 medium, 3 high
+  Cursor m_providerCursor;
+  Cursor m_streamCursor;
+  int m_optionRow;
+  int m_sourceColumn;  // 0 providers, 1 streams, 2 options
+};
+
+}  // namespace Numstremio
