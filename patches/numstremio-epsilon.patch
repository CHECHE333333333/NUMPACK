diff --git a/epsilon/apps/numstremio/model.h b/epsilon/apps/numstremio/model.h
new file mode 100644
index 0000000000..230dbde2b2
--- /dev/null
+++ b/epsilon/apps/numstremio/model.h
@@ -0,0 +1,147 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+// Pure logic of NumStremio (no Escher, no Ion): frame parsing and list
+// navigation. It builds on the host too (tests/host_model_test.cpp).
+namespace Numstremio {
+
+// Bounds-checked reader of a frame payload. Every read fails (and stays
+// failed) instead of running past the end: frames come from a PC program.
+class Reader {
+ public:
+  Reader(const uint8_t* data, size_t length) : m_data(data), m_length(length), m_cursor(0), m_ok(true) {}
+  bool ok() const { return m_ok; }
+  size_t remaining() const { return m_length - m_cursor; }
+  const uint8_t* position() const { return m_data + m_cursor; }
+
+  uint8_t u8() {
+    if (!m_ok || m_cursor + 1 > m_length) {
+      m_ok = false;
+      return 0;
+    }
+    return m_data[m_cursor++];
+  }
+  uint16_t u16() {
+    const uint8_t low = u8();
+    const uint8_t high = u8();
+    return static_cast<uint16_t>(low | (high << 8));
+  }
+  // str8 into destination (always 0-terminated, cut on a character boundary).
+  bool str8(char* destination, size_t capacity) {
+    const size_t size = u8();
+    if (!m_ok || m_cursor + size > m_length || capacity == 0) {
+      m_ok = false;
+      return false;
+    }
+    size_t count = size < capacity - 1 ? size : capacity - 1;
+    while (count > 0 && count < size && (static_cast<uint8_t>(m_data[m_cursor + count]) & 0xC0) == 0x80) {
+      count--;
+    }
+    memcpy(destination, m_data + m_cursor, count);
+    destination[count] = '\0';
+    m_cursor += size;
+    return true;
+  }
+
+ private:
+  const uint8_t* m_data;
+  size_t m_length;
+  size_t m_cursor;
+  bool m_ok;
+};
+
+// Selection in a list taller than the screen.
+class Cursor {
+ public:
+  explicit Cursor(int visible) : m_visible(visible), m_count(0), m_selection(0), m_first(0) {}
+  void reset(int count) {
+    m_count = count < 0 ? 0 : count;
+    m_selection = m_first = 0;
+  }
+  int count() const { return m_count; }
+  int selection() const { return m_selection; }
+  int first() const { return m_first; }
+  int visible() const { return m_visible; }
+  // Returns true when the selection moved (false at either end).
+  bool move(int delta) {
+    const int next = m_selection + delta;
+    if (next < 0 || next >= m_count) {
+      return false;
+    }
+    m_selection = next;
+    if (m_selection < m_first) {
+      m_first = m_selection;
+    } else if (m_selection >= m_first + m_visible) {
+      m_first = m_selection - m_visible + 1;
+    }
+    return true;
+  }
+  void select(int index) {
+    m_selection = index < 0 ? 0 : (index >= m_count ? (m_count > 0 ? m_count - 1 : 0) : index);
+    m_first = m_selection >= m_visible ? m_selection - m_visible + 1 : 0;
+  }
+
+ private:
+  int m_visible;
+  int m_count;
+  int m_selection;
+  int m_first;
+};
+
+// Cycles 0..count-1 (count 0 stays 0).
+inline int cycle(int value, int delta, int count) {
+  if (count <= 0) {
+    return 0;
+  }
+  return ((value + delta) % count + count) % count;
+}
+
+// Copies at most `glyphs` characters (combining accents take no room), adding
+// "..." when cut. Returns the number of bytes written (without the final 0).
+inline size_t clip(char* destination, size_t capacity, const char* text, int glyphs) {
+  size_t out = 0;
+  int shown = 0;
+  size_t i = 0;
+  const size_t length = strlen(text);
+  while (i < length) {
+    size_t j = i + 1;
+    while (j < length && (static_cast<uint8_t>(text[j]) & 0xC0) == 0x80) {
+      j++;
+    }
+    const uint8_t lead = static_cast<uint8_t>(text[i]);
+    const bool combining = lead == 0xCC || lead == 0xCD;
+    if (!combining) {
+      if (shown == glyphs) {
+        // Too long: replace the end by "...".
+        int back = 0;
+        while (out > 0 && back < 3) {
+          out--;
+          while (out > 0 && (static_cast<uint8_t>(destination[out]) & 0xC0) == 0x80) {
+            out--;
+          }
+          back++;
+        }
+        if (out + 4 <= capacity) {
+          memcpy(destination + out, "...", 3);
+          out += 3;
+        }
+        destination[out] = '\0';
+        return out;
+      }
+      shown++;
+    }
+    if (out + (j - i) + 1 > capacity) {
+      break;
+    }
+    memcpy(destination + out, text + i, j - i);
+    out += j - i;
+    i = j;
+  }
+  destination[out] = '\0';
+  return out;
+}
+
+}  // namespace Numstremio
