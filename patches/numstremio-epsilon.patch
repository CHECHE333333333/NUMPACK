diff --git a/epsilon/apps/numstremio/protocol.h b/epsilon/apps/numstremio/protocol.h
new file mode 100644
index 0000000000..b4ab7cd9d5
--- /dev/null
+++ b/epsilon/apps/numstremio/protocol.h
@@ -0,0 +1,37 @@
+#pragma once
+
+#include <stdint.h>
+
+// Frame types of NumStremio, carried in TMIA frames (see apps/numtube/link.h).
+// Keep in sync with gateway/numstremio_service.py. Errors use Numtube's 0x07.
+// Strings are "str8": one length byte, then UTF-8 (accents decomposed).
+namespace Numstremio {
+namespace Protocol {
+
+enum Type : uint8_t {
+  Error = 0x07,
+  Start = 0xB0,        // calc -> PC
+  Config = 0xB1,       // PC -> calc: u8 n, n * str8 genre
+  Browse = 0xB2,       // calc -> PC: u8 kind (0 all, 1 movie, 2 series), u8 genre (0 = all, else 1-based), u16 page, query
+  Item = 0xB3,         // PC -> calc: u8 slot, u8 kind, str8 id, str8 title, str8 info
+  ListDone = 0xB4,     // PC -> calc: u8 count, u8 more, u16 page
+  Open = 0xB5,         // calc -> PC: u8 kind, str8 id
+  Detail = 0xB6,       // PC -> calc: u8 kind, str8 title, str8 info, u8 n, n * u8 season
+  Episode = 0xB7,      // PC -> calc: u16 number, str8 title
+  Season = 0xB8,       // calc -> PC: u8 season
+  EpisodesDone = 0xB9, // PC -> calc: u8 season, u8 count
+  Streams = 0xBA,      // calc -> PC: u8 season (255: none), u16 episode
+  Providers = 0xBB,    // PC -> calc: u8 n, n * str8 name
+  Stream = 0xBC,       // PC -> calc: u8 index, u8 provider (1-based), str8 line 1, str8 line 2
+  StreamsDone = 0xBD,  // PC -> calc: u8 count
+  SubLangs = 0xBE,     // PC -> calc: u8 n, n * str8 label
+  Poster = 0xBF,       // PC -> calc: u8 slot, u8 w, u8 h, RGB565 little endian
+};
+
+constexpr uint8_t k_noSeason = 255;
+constexpr int k_pageSize = 6;
+constexpr int k_posterWidth = 28;
+constexpr int k_posterHeight = 42;
+
+}  // namespace Protocol
+}  // namespace Numstremio
